---
import { DIFFICULTY_LABELS } from '../lib/difficulty';
import type { ReportFight } from '../lib/service-types';

interface Props {
  fights: ReportFight[];
  /** The report on warcraftlogs.com, for the raider who wants the real thing. */
  url: string;
  /** The pull the board below is showing, or null while it shows the whole night. */
  selected: number | null;
  /** Where a pull points: selecting it, with whatever else the board is carrying. */
  href: (fightID: number | null) => string;
}

const { fights, url, selected, href } = Astro.props;

/*
 * One small card per boss, and the card is mostly its own trajectory.
 *
 * This has been drawn three times. Full-width bands stacked down the page read well for
 * twelve pulls on one boss and turned a six-boss clear into a screen and a half. Wider
 * cards with a bar per pull fixed the stacking and kept the problem: a bar chart of two
 * pulls is not a chart, it is two rectangles.
 *
 * What a raid lead reads off a boss is one shape: did we get there, and were we getting
 * closer. That is a line, and a line survives being small.
 */
type Boss = {
  encounter: string;
  difficulty?: string | undefined;
  fights: ReportFight[];
};

// A run of consecutive pulls on the same encounter. Not keyed by name: a guild that comes
// back to a boss after clearing another one had two runs at it, and merging them draws a
// night that did not happen.
const bosses: Boss[] = [];
for (const fight of fights) {
  const last = bosses[bosses.length - 1];
  if (last && last.encounter === fight.encounter) {
    last.fights.push(fight);
    continue;
  }
  bosses.push({
    encounter: fight.encounter,
    difficulty: fight.difficulty ? DIFFICULTY_LABELS[fight.difficulty] : undefined,
    fights: [fight],
  });
}

/**
 * How far into the boss a pull got, 0 to 100.
 *
 * The service sends health remaining, so this is the other side of the same number. Not a
 * statistic, just which end of the plot it is measured from. A pull WarcraftLogs could not
 * measure has no position at all and is left off the line rather than drawn at zero.
 */
function progress(fight: ReportFight): number | null {
  if (fight.kill) {
    return 100;
  }
  if (fight.boss_percentage === undefined) {
    return null;
  }
  return Math.max(0, Math.min(100, 100 - fight.boss_percentage));
}

function length(fight: ReportFight): string {
  const minutes = Math.floor(fight.duration_seconds / 60);
  const seconds = fight.duration_seconds % 60;
  return minutes > 0 ? `${minutes}m ${seconds}s` : `${seconds}s`;
}

/** One pull, said the way a raid lead says it. */
function readout(fight: ReportFight, ordinal: number): string {
  if (fight.kill) {
    return `Pull ${ordinal}: kill, ${length(fight)}`;
  }
  if (fight.boss_percentage === undefined) {
    return `Pull ${ordinal}: wipe, ${length(fight)}`;
  }
  return `Pull ${ordinal}: wipe at ${fight.boss_percentage.toFixed(1)}%, ${length(fight)}`;
}

/**
 * What became of the boss, in one line. Picking among numbers the service sent, which is
 * reading rather than working anything out.
 */
function outcome(boss: Boss): string {
  const killIndex = boss.fights.findIndex((fight) => fight.kill);
  if (killIndex >= 0) {
    return boss.fights.length === 1 ? 'Killed first pull' : `Killed on pull ${killIndex + 1}`;
  }
  const measured = boss.fights
    .map((fight) => fight.boss_percentage)
    .filter((percentage): percentage is number => percentage !== undefined);
  if (measured.length === 0) {
    return 'No kill';
  }
  return `Best ${Math.min(...measured).toFixed(1)}%`;
}

/*
 * The plot is in percentages, not user units, because a card is whatever width the grid
 * gives it: alone on a row it takes the whole width, and beside five others it takes a
 * sixth of it.
 *
 * The line lives in an SVG stretched to that box, which is what non-scaling-stroke exists
 * for. The dots do not: a stretched circle is an ellipse, so they are positioned HTML,
 * which also makes each one a link to its own pull.
 */
const PAD = 12;

type Point = { x: number; y: number; fight: ReportFight; ordinal: number };

function plot(boss: Boss): Point[] {
  const points: Point[] = [];
  boss.fights.forEach((fight, index) => {
    const reached = progress(fight);
    if (reached === null) {
      return;
    }
    // One pull sits in the middle rather than at the left edge, where it would read as
    // the start of a line that never happened.
    const x = boss.fights.length === 1 ? 50 : (index / (boss.fights.length - 1)) * 100;
    const y = 100 - PAD - (reached / 100) * (100 - PAD * 2);
    points.push({ x, y, fight, ordinal: index + 1 });
  });
  return points;
}
---

<ol class="bosses">
  {
    bosses.map((boss) => {
      const points = plot(boss);
      const killed = boss.fights.some((fight) => fight.kill);
      const last = points[points.length - 1];
      return (
        <li class:list={['boss', killed && 'boss--killed']}>
          <div class="plot">
            {/* Inset by half the widest dot, so the first and last pull sit inside the
                box instead of hanging over its edges. */}
            <div class="plot__area">
              <svg
                class="plot__canvas"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                {/* Where the boss dies. A line that reaches it killed something. */}
                <line
                  class="plot__top"
                  x1="0"
                  y1={PAD}
                  x2="100"
                  y2={PAD}
                  vector-effect="non-scaling-stroke"
                />
                {points.length > 1 && (
                  <polyline
                    class="plot__line"
                    points={points.map((point) => `${point.x},${point.y}`).join(' ')}
                    vector-effect="non-scaling-stroke"
                  />
                )}
              </svg>

              {points.map((point) => (
                <a
                  class:list={[
                    'plot__dot',
                    point.fight.kill && 'plot__dot--kill',
                    point === last && 'plot__dot--last',
                    point.fight.fight_id === selected && 'plot__dot--selected',
                  ]}
                  style={`--x: ${point.x}%; --y: ${point.y}%`}
                  href={href(point.fight.fight_id)}
                  aria-current={point.fight.fight_id === selected ? 'true' : undefined}
                  title={readout(point.fight, point.ordinal)}
                >
                  <span class="visually-hidden">
                    {readout(point.fight, point.ordinal)}. Show this pull.
                  </span>
                </a>
              ))}
            </div>
          </div>

          <p class="boss__outcome">{outcome(boss)}</p>

          {/* The name sits under its own shape rather than over it: across a grid of six
              you find the boss you mean by the line first and read the name to confirm. */}
          <h3 class="boss__name">{boss.encounter}</h3>
          <p class="boss__meta">
            {boss.difficulty && <span>{boss.difficulty}</span>}
            <span>
              {boss.fights.length} {boss.fights.length === 1 ? 'pull' : 'pulls'}
            </span>
          </p>

          {/* Every pull, in the product's own words, and every one of them a way into that
              pull on WarcraftLogs. The plot is the shape; this is the detail behind it. */}
          <ul class="boss__pulls">
            {boss.fights.map((fight, index) => (
              <li>
                <a
                  class:list={[
                    'boss__pull',
                    fight.kill && 'boss__pull--kill',
                    fight.fight_id === selected && 'boss__pull--selected',
                  ]}
                  href={href(fight.fight_id)}
                  aria-current={fight.fight_id === selected ? 'true' : undefined}
                >
                  {readout(fight, index + 1)}
                </a>
              </li>
            ))}
          </ul>

          {/* One way out to the real report per boss, rather than one per pull. Clicking a
              pull now belongs to the board below. */}
          <a class="boss__logs" href={`${url}#fight=${boss.fights[0]!.fight_id}`} rel="noreferrer">
            View on WarcraftLogs
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .bosses {
    display: grid;
    gap: 0.75rem;
    /*
     * auto-fit, not auto-fill: empty tracks collapse, so the cards spread into whatever
     * room there is. One boss takes the whole row.
     *
     * The track floor is a sixth of the row, which is what caps a row at six: a seventh
     * card cannot fit beside them and wraps. It is also never below 13rem, where the
     * pull list stops being readable, and never above the full width, so a phone gets one
     * column rather than a column it cannot fit.
     */
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(13rem, (100% - 5 * 0.75rem) / 6)), 1fr)
    );
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .boss {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    /* The hue is the outcome, and it is the whole point of the card at this size: a
       night of five green cards and one red is read without any reading. */
    --hue: var(--danger);
    transition: border-color var(--dur-1) var(--ease);
  }

  .boss--killed {
    --hue: var(--success);
  }

  .boss:hover,
  .boss:focus-within {
    border-color: var(--border-strong);
  }

  /*
   * A fixed height rather than an aspect ratio, so a card alone on a row grows sideways
   * and not into a billboard.
   *
   * The sweep is the one authored moment on this surface: each boss's trajectory wipes in
   * from the left, so the night replays in the order it happened and the dots arrive as
   * it reaches them.
   *
   * A clip rather than a stroke dash. The dash version drew the line by hiding it and
   * revealing it, which left its resting state invisible, and anything that interrupted
   * the animation stopped the line halfway to its own last point. This one is finished by
   * default: the animation only takes it away and gives it back.
   *
   * Its own curve rather than --ease, for the reason the analysis bars state: the
   * surface's exponential ease-out puts a long sweep at nine tenths of its length in the
   * first hundred milliseconds, where the movement never reads.
   */
  .plot {
    position: relative;
    height: 3.25rem;
    margin-bottom: 0.25rem;
    animation: plot-sweep 620ms cubic-bezier(0.33, 0.86, 0.44, 1) both;
  }

  @keyframes plot-sweep {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Half the widest dot, so a pull at 0% or 100% is drawn whole rather than sliced by
     the edge of its own card. */
  .plot__area {
    position: absolute;
    inset: 0 7px;
  }

  /* Stretched to the box on both axes. The stroke keeps its width regardless, which is
     exactly what non-scaling-stroke is for. */
  .plot__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The kill line. Dashed and dim: it is a reference, not a reading. */
  .plot__top {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .plot__line {
    fill: none;
    stroke: var(--hue);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * HTML, not SVG. The canvas above is stretched on both axes, and a stretched circle is
   * an ellipse; positioning the dots here keeps them round at any card width and makes
   * each one a link to its own pull.
   */
  .plot__dot {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: 9px;
    height: 9px;
    box-sizing: border-box;
    border: 1.5px solid var(--hue);
    border-radius: var(--radius-full);
    background: var(--raised);
    transform: translate(-50%, -50%);
    transition:
      transform var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease);
  }

  .plot__dot--kill {
    background: var(--hue);
  }

  /* Where the night got to on this boss, which is the point the eye should land on. */
  .plot__dot--last {
    width: 12px;
    height: 12px;
  }

  .plot__dot:hover,
  .plot__dot:focus-visible {
    background: var(--hue);
    transform: translate(-50%, -50%) scale(1.25);
  }

  /* The pull the board is showing. Amber marks where you are, and the ring keeps it
     legible on top of a dot already carrying the outcome hue. */
  .plot__dot--selected {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .boss__outcome {
    margin: 0;
    color: var(--hue);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .boss__name {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .boss__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /*
   * Capped and scrolled inside itself. A grid row is as tall as its tallest card, so a
   * twelve-pull progression boss beside five one-pull kills would leave the whole row
   * mostly empty to make room for a list only one card has.
   */
  .boss__pulls {
    display: grid;
    gap: 0.125rem;
    max-height: 6.5rem;
    overflow-y: auto;
    margin: 0.25rem 0 0;
    padding: 0.5rem 0 0;
    border-top: 1px solid var(--border-subtle);
    list-style: none;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .boss__pull {
    display: block;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .boss__pull--kill {
    color: var(--text-secondary);
  }

  .boss__pull:hover,
  .boss__pull:focus-visible {
    color: var(--text-primary);
  }

  /* Amber, because this is where you are. It is the one thing on this surface amber is
     allowed to mean besides the primary action. */
  .boss__pull--selected {
    color: var(--accent);
    font-weight: 600;
  }

  .boss__logs {
    margin-top: 0.5rem;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .boss__logs:hover,
  .boss__logs:focus-visible {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  /* The plot is already whole without the sweep, so dropping it leaves the night complete
     rather than empty. */
  @media (prefers-reduced-motion: reduce) {
    .plot {
      animation: none;
    }
  }
</style>
