---
import SiteNav from '../components/site-nav.astro';
import BaseLayout from './base-layout.astro';

interface Props {
  title: string;
  /**
   * Pairs the page title with the element it was opened from, so the two morph into
   * each other across the navigation. Only pages reached from a list set it.
   */
  titleTransition?: string | undefined;
  /**
   * Puts the title band on parchment. The event page is the only caller and is meant to
   * be: it is the far end of the morph that starts on the overview's summons, and a
   * raid name that travels from paper onto dark ground lands looking like a different
   * object. The band is owned by this layout, so the page cannot reach it itself.
   */
  vellum?: boolean | undefined;
}

const { title, titleTransition, vellum = false } = Astro.props;
---

<BaseLayout title={title}>
  <SiteNav />
  <main class="page" id="main">
    <div class:list={['page-head', vellum && 'page-head--vellum vellum']}>
      <div class="page-head__title">
        <h1>
          {titleTransition ? <span transition:name={titleTransition}>{title}</span> : title}
        </h1>
        <slot name="head" />
      </div>
      <slot name="actions" />
    </div>
    <slot />
  </main>
</BaseLayout>

<style>
  .page-head__title {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  /* The sheet the raid name arrives on. Shallower than the overview's summons, because
     this one is a header over a page of signups rather than the whole answer. */
  .page-head--vellum {
    align-items: center;
    padding: 1.125rem 1.375rem;
  }

  .page-head--vellum :global(h1) {
    font-size: var(--fs-2xl);
  }
</style>
