---
import CompAdvisories from '../../../components/comp-advisories.astro';
import EventChips from '../../../components/event-chips.astro';
import MeterBoard, { type Metric } from '../../../components/meter-board.astro';
import PullTimeline from '../../../components/pull-timeline.astro';
import DashboardLayout from '../../../layouts/dashboard-layout.astro';
import { DIFFICULTY_LABELS } from '../../../lib/difficulty';
import {
  fetchGuildTimezone,
  formatEventTime,
  formatSignupWindow,
  instantToGuildTime,
} from '../../../lib/guild-time';
import { getLink, hasLink } from '../../../lib/links';
import { ROLE_HUES, ROLE_LABELS, ROLE_ORDER } from '../../../lib/roles';
import { noticeFor } from '../../../lib/service-notice';
import { ServiceError } from '../../../lib/service-error';
import { STATUS_HUES, STATUS_LABELS } from '../../../lib/signup-status';
import { classColor } from '../../../lib/wow-class';
import type {
  Assignment,
  Board,
  Character,
  CompInfo,
  Event,
  EventReport,
  LateRequest,
  ReportFight,
  ReminderDelivery,
  Role,
  Signup,
} from '../../../lib/service-types';

export const prerender = false;

const { session, actor, client } = Astro.locals;

if (!session!.selectedGuildId) {
  return Astro.redirect('/guild');
}

const guildId = session!.selectedGuildId;
const eventId = Astro.params.id!;

// What a write route sent us back with. Codes rather than the service's own words: a
// message round-tripped through a query string is a message anyone can put on screen.
const NOTICES: Record<string, string> = {
  late: 'Signups have closed. A raid lead has to approve that.',
  denied: 'That is not yours to change.',
  gone: 'That character is no longer on this event.',
  started: 'That raid has already started, so the sheet is final.',
  badlog:
    'That is not a WarcraftLogs report link. It should look like https://www.warcraftlogs.com/reports/aBcD1234.',
  failed: 'Raider Mate had a problem with that.',
  unreachable: 'Raider Mate is not answering right now.',
  manual: 'That comp is manual. Locking it would throw the board away.',
  invalid: 'Check the fields. Something in there is not a raid.',
  backwards: 'Signups would close after the raid starts. Check the two times.',
  saved: 'Saved. The signup sheet in Discord follows.',
  approved: 'Approved. They are on the sheet.',
  rejected: 'Rejected. Nothing on the sheet changed.',
  decided: 'Someone answered that one already.',
  rereading: 'Reading the report again. The numbers follow.',
};
const code = Astro.url.searchParams.get('notice') ?? '';
const notice = NOTICES[code];
// The rest are refusals and wear the danger colour. These are writes that went through,
// a rejection included: answering a request is the queue working, not a failure.
const noticeIsGood = code === 'saved' || code === 'approved' || code === 'rejected';

let event: Event | null = null;
let failure: string | null = null;

try {
  event = await client.get<Event>(actor, `/api/events/${eventId}`);
} catch (error) {
  // The service answers 404 for both "no such event" and "not your guild", on purpose.
  // Telling them apart here would leak the difference it declined to leak.
  if (error instanceof ServiceError && error.isNotFound) {
    Astro.response.status = 404;
    failure = 'No such event.';
  } else {
    failure = noticeFor(error);
  }
}

let timezone: string | null = null;
let signups: Signup[] = [];
let boards: Board[] = [];
let lateRequests: LateRequest[] = [];
let mine: Character[] = [];
let names = new Map<string, string>();

if (event) {
  timezone = await fetchGuildTimezone(client, actor, guildId);

  try {
    // Followed, not built: the event said where its signups live.
    signups = (await client.follow<Signup[]>(actor, getLink(event, 'signups')!)).body;

    const comps = (await client.follow<CompInfo[]>(actor, getLink(event, 'comps')!)).body;
    boards = await Promise.all(
      comps.map(async (comp) => (await client.follow<Board>(actor, getLink(comp, 'self')!)).body),
    );

    mine = await client.get<Character[]>(actor, `/api/users/${session!.discordId}/characters`);

    const lateLink = getLink(event, 'late-requests');
    if (lateLink) {
      lateRequests = (await client.follow<LateRequest[]>(actor, lateLink)).body;
      // Late requests carry a character id and nothing else, and a raid lead cannot
      // approve a UUID. The roster is the only place the name lives.
      const roster = await client.get<Character[]>(actor, `/api/guilds/${guildId}/characters`);
      names = new Map(roster.map((c) => [c.id, c.name]));
    }
  } catch (error) {
    failure = noticeFor(error);
  }
}

// The link is what the service offered; warcraftlogs_url is the same string on the
// resource. Reading the link keeps this rendering from what was handed over.
const logsUrl = event ? getLink(event, 'warcraftlogs')?.href : undefined;

/*
 * What the log said, once the service has read it.
 *
 * Three rels, exactly one of them present, and the rel name is the state: `report` has
 * numbers, `report-pending` means Raider Mate is still reading, `report-failed` means it
 * could not. None of them means this instance has no WarcraftLogs credentials, and the
 * page keeps the plain outbound link it has always had.
 */
const reportLink = event ? getLink(event, 'report') : undefined;
const reportPending = event ? hasLink(event, 'report-pending') : false;
const reportFailed = event ? hasLink(event, 'report-failed') : false;

let report: EventReport | null = null;
if (event && reportLink) {
  try {
    report = (await client.follow<EventReport>(actor, reportLink)).body;
  } catch {
    // The event reads fine without it. A page that blanks because one panel failed is
    // worse than a page missing that panel.
    report = null;
  }
}

// Which board is on screen. A real link per metric, like the analysis sort: no script,
// and a filtered view is a URL a raid lead can paste into Discord.
const METRICS: Metric[] = ['damage', 'healing', 'deaths'];
const requestedMetric = Astro.url.searchParams.get('metric');
const metric: Metric = METRICS.includes(requestedMetric as Metric)
  ? (requestedMetric as Metric)
  : 'damage';

const METRIC_LABELS: Record<Metric, string> = {
  damage: 'Damage',
  healing: 'Healing',
  deaths: 'Deaths',
};

/*
 * Which pull the board is showing, or the whole night.
 *
 * The service sends every pull's numbers with the report, so selecting one costs a render
 * and no request. It is still a query parameter rather than script: a pull worth arguing
 * about is a URL worth pasting into Discord.
 */
const requestedFight = Number.parseInt(Astro.url.searchParams.get('fight') ?? '', 10);
const selectedFight = report?.fights.find((fight) => fight.fight_id === requestedFight) ?? null;

/**
 * Which pull this is on its own boss, counting from one.
 *
 * Not its place in the night: the cards above number pulls within a boss, and a board
 * calling the same pull "pull 7" while the card beside it says "Pull 2" would be two
 * names for one thing.
 */
function pullOrdinal(fight: ReportFight): number {
  // Counts back through the run of pulls immediately before this one on the same boss,
  // and stops at anything else. The cards group by consecutive run for the same reason: a
  // guild that comes back to a boss later had two runs at it, not one long one.
  const all = report?.fights ?? [];
  const at = all.indexOf(fight);
  let ordinal = 1;
  for (let before = at - 1; before >= 0; before -= 1) {
    if (all[before]!.encounter !== fight.encounter) {
      break;
    }
    ordinal += 1;
  }
  return ordinal;
}

/** Where the board points, keeping whatever it is not changing. */
function boardHref(next: { metric?: Metric; fight?: number | null }): string {
  const params = new URLSearchParams();
  const wanted = next.metric ?? metric;
  if (wanted !== 'damage') {
    params.set('metric', wanted);
  }
  const fight = next.fight === undefined ? (selectedFight?.fight_id ?? null) : next.fight;
  if (fight !== null) {
    params.set('fight', String(fight));
  }
  const query = params.toString();
  return `/events/${eventId}${query ? `?${query}` : ''}#board`;
}

/**
 * What the service could not read, said in one sentence with the way out of it. The
 * status names the problem; the recovery is the raid lead's, not ours.
 */
const REPORT_TROUBLE: Record<string, string> = {
  PRIVATE:
    'WarcraftLogs will not show this report to Raider Mate. Set it to Unlisted on the report page and this fills in on the next check.',
  NOT_FOUND: 'WarcraftLogs has no report at that link. Check it and paste it again.',
  ARCHIVED: 'WarcraftLogs has archived this report, so the numbers behind it are gone.',
  UNAVAILABLE: 'WarcraftLogs is not answering. Raider Mate will try again.',
};

// The page flips once there are numbers. Before that it is the page it has always been.
const flipped = report !== null && report.status === 'READY';

const signedUp = new Set(signups.map((signup) => signup.character_id));
// Main first, since it is the character most people are signing up: everyone else
// alphabetically, so a long roster of alts is still findable without a search box.
const unsigned = mine
  .filter((character) => !signedUp.has(character.id))
  .sort((a, b) => Number(b.is_main) - Number(a.is_main) || a.name.localeCompare(b.name));
const now = new Date();

const mineIds = new Set(mine.map((character) => character.id));
const isMine = (signup: Signup) => mineIds.has(signup.character_id);

/**
 * Everyone reads the whole roster, which is what the event post in Discord shows anyway.
 * Your own characters come first and stay marked, because the row you can act on is the
 * one you came for, and hunting for your own name down a column of thirty is the thing
 * this page should not make you do.
 *
 * Ordering only. Who may change a signup is the service's answer: it sends
 * allowed_statuses and the withdraw link for your own characters, and for anyone's only
 * to a raid lead. Rows you cannot act on arrive with no controls to render.
 */
const shown = [...signups.filter(isMine), ...signups.filter((signup) => !isMine(signup))];

function bench(board: Board): Assignment[] {
  return board.slots.filter((slot) => slot.is_bench);
}

function inRole(board: Board, role: Role): Assignment[] {
  return board.slots.filter((slot) => !slot.is_bench && slot.role === role);
}

function slotName(slot: Assignment): string {
  return slot.character?.name ?? slot.character_id;
}

/**
 * Why the assigner put someone where it did. A manual board has no such answer: the
 * service stamps every hand-placed slot with the same sentence, and repeating "placed by
 * a raid lead" twenty times says nothing the Manual badge above has not already said.
 */
function reasonFor(board: Board, slot: Assignment): string | undefined {
  return board.mode === 'MANUAL' ? undefined : slot.reason;
}

/**
 * What to say about the pre-event reminder, or nothing. The service decided the state;
 * this picks the sentence for it.
 *
 * A reminder that fired and reached people is worth a line to everyone, since knowing
 * the ping is coming is the point of it. A reminder that reached nobody is a raid
 * lead's problem to fix, so it goes to whoever the service offered the edit link.
 */
const REMINDER_TARGET: Record<ReminderDelivery, string> = {
  PING: 'the events channel',
  DM: 'everyone signed up',
  BOTH: 'the events channel and everyone signed up',
};

const SKIP_REASONS: Record<string, string> = {
  no_channel: 'This event has no Discord channel to post in.',
  no_recipients: 'Nobody had signed up when it fired.',
  not_scheduled: 'None is scheduled. An edit made inside the lead time cancels it.',
};

function reminderNote(): { text: string; bad: boolean } | null {
  const reminder = event?.reminder;
  if (!reminder || reminder.state === 'OFF') {
    return null;
  }

  const mayFix = event ? hasLink(event, 'edit') : false;

  switch (reminder.state) {
    case 'SCHEDULED':
      return {
        text: `Reminder pings ${REMINDER_TARGET[reminder.delivery]} ${reminder.lead_minutes} minutes before the pull.`,
        bad: false,
      };
    case 'SENT':
      return { text: 'Reminder sent.', bad: false };
    case 'SKIPPED':
      return mayFix
        ? {
            text: `The reminder went to nobody. ${SKIP_REASONS[reminder.reason ?? ''] ?? ''}`.trim(),
            bad: true,
          }
        : null;
    case 'FAILED':
      return mayFix ? { text: 'The reminder did not go out.', bad: true } : null;
  }
}

const reminder = reminderNote();

const SIZES = [
  { name: 'tanks', label: 'Tanks' },
  { name: 'healers', label: 'Healers' },
  { name: 'max_melee', label: 'Melee' },
  { name: 'max_ranged', label: 'Ranged' },
];

/**
 * One size out of the event's comp template, for prefilling the edit form. Empty when the
 * template names none, which is the raid asking the assigner to work it out.
 *
 * comp_template is typed unknown on purpose: the service owns its shape. This reads the
 * four keys the form writes and claims nothing about the rest.
 */
function templateSize(field: string): number | '' {
  const template = event?.comp_template;
  if (typeof template !== 'object' || template === null) {
    return '';
  }
  const value = (template as Record<string, unknown>)[field];
  return typeof value === 'number' && Number.isFinite(value) ? value : '';
}
---

<DashboardLayout
  title={event?.title ?? 'Event'}
  titleTransition={event ? `event-title-${event.id}` : undefined}
>
  {
    event && (
      <div slot="head" class="head">
        <span transition:name={`event-chips-${event.id}`}>
          <EventChips event={event} />
        </span>
        <span class="head__time">
          Starts{' '}
          <time datetime={event.starts_at}>{formatEventTime(event.starts_at, timezone)}</time>
        </span>
        <span class="head__time head__time--muted">
          Signups {formatSignupWindow(event.signup_deadline, now).toLowerCase()}
          {', '}
          <time datetime={event.signup_deadline}>
            {formatEventTime(event.signup_deadline, timezone)}
          </time>
        </span>
      </div>
    )
  }

  {
    event && (
      <a slot="actions" class="button button--quiet" href="/events">
        All events
      </a>
    )
  }

  {notice && <p class:list={['notice', noticeIsGood && 'notice--good']}>{notice}</p>}
  {failure && <p class="notice">{failure}</p>}

  {reminder && <p class:list={[reminder.bad ? 'notice' : 'reminder']}>{reminder.text}</p>}

  {
    /* Rendered from the links and nothing else: a raider with a report to read sees the
       link, a raid lead also sees the control, and someone offered neither sees no
       strip at all. */
    event && (hasLink(event, 'warcraftlogs') || hasLink(event, 'set-warcraftlogs')) && (
      <div class="logs">
        {logsUrl ? (
          <a class="logs__link" href={logsUrl} rel="noreferrer">
            WarcraftLogs report
          </a>
        ) : (
          <span class="muted">No logs linked to this raid yet.</span>
        )}

        {hasLink(event, 'set-warcraftlogs') && (
          <details class="logs__edit">
            <summary>{logsUrl ? 'Change' : 'Link the logs'}</summary>
            <div class="logs__forms">
              <form method="post" action={`/events/${event.id}/warcraftlogs`} data-astro-reload>
                <input
                  type="url"
                  name="warcraftlogs_url"
                  value={logsUrl ?? ''}
                  placeholder="https://www.warcraftlogs.com/reports/aBcD1234"
                  aria-label="WarcraftLogs report URL"
                />
                <button class="button" type="submit">
                  Save
                </button>
              </form>
              {/* Its own form: an empty value in the one above would lose to the input
                  it sits beside, and the raid lead would save the URL they meant to
                  remove. */}
              {logsUrl && (
                <form method="post" action={`/events/${event.id}/warcraftlogs`} data-astro-reload>
                  <input type="hidden" name="warcraftlogs_url" value="" />
                  <button class="button button--ghost" type="submit">
                    Remove
                  </button>
                </form>
              )}
              {/* Only where the service offered it. A report is read once and left
                  alone, so this is for the night WarcraftLogs was down, or the report
                  that has just stopped being private. */}
              {hasLink(event, 'refresh-report') && (
                <form method="post" action={`/events/${event.id}/report-refresh`} data-astro-reload>
                  <button class="button button--ghost" type="submit">
                    Read it again
                  </button>
                </form>
              )}
            </div>
          </details>
        )}
      </div>
    )
  }

  {
    /* Raider Mate is reading the report. One line, because the wait is minutes and a
       full panel promising numbers is worse than a sentence saying they are coming. */
    reportPending && (
      <p class="reminder">Raider Mate is reading the report. Numbers land here shortly.</p>
    )
  }

  {
    reportFailed && report && (
      <p class="notice">{REPORT_TROUBLE[report.status] ?? REPORT_TROUBLE.UNAVAILABLE}</p>
    )
  }

  {
    flipped && report && event && (
      <>
        {report.live && (
          <p class="reminder">
            This raid is still going, so the numbers below are real but not final.
          </p>
        )}

        {/* No panel around it. The boss cards are the cards; wrapping them in another
            one would nest a card inside a card, which this system does not do. */}
        <section class="section">
          <h2>The night</h2>
          {report.fights.length > 0 ? (
            <PullTimeline
              fights={report.fights}
              url={report.url}
              selected={selectedFight?.fight_id ?? null}
              href={(fight) => boardHref({ fight })}
            />
          ) : (
            <div class="panel">
              <div class="panel__body">
                <p class="muted">The report has no boss pulls in it.</p>
              </div>
            </div>
          )}
        </section>

        {report.raiders.length > 0 && (
          <section class="panel recap-panel" id="board">
            <div class="panel__head">
              <div class="board-head">
                <h2>{METRIC_LABELS[metric]}</h2>
                {/* What the numbers below are of. A pull that WarcraftLogs was not read
                    individually for falls back to the night rather than showing nothing,
                    and says so. */}
                <p class="board-head__scope">
                  {selectedFight
                    ? selectedFight.raiders
                      ? `${selectedFight.encounter}, pull ${pullOrdinal(selectedFight)}`
                      : `${selectedFight.encounter}: this pull was not read on its own`
                    : 'The whole night'}
                </p>
              </div>
              <nav class="metrics" aria-label="Metric">
                {METRICS.map((option) => (
                  <a
                    class="metrics__link"
                    href={boardHref({ metric: option })}
                    aria-current={option === metric ? 'page' : undefined}
                  >
                    {METRIC_LABELS[option]}
                  </a>
                ))}
              </nav>
            </div>
            <div class="panel__body">
              {selectedFight && (
                <a class="board-reset" href={boardHref({ fight: null })}>
                  Back to the whole night
                </a>
              )}
              <MeterBoard
                raiders={selectedFight?.raiders ?? report.raiders}
                metric={metric}
                mine={mineIds}
              />
            </div>
          </section>
        )}

        <section class="section">
          <h2>Who showed</h2>
          {report.turnout.roster_overlap < 0.34 && report.raiders.length > 0 && (
            <p class="notice">
              Hardly anybody in this report is on your roster. It may belong to a different night.
            </p>
          )}
          <div class="panel">
            <div class="panel__body turnout">
              <div>
                <h3 class="turnout__head">Turned up</h3>
                {report.turnout.attended.length > 0 ? (
                  <ul class="turnout__list">
                    {report.turnout.attended.map((raider) => (
                      <li>
                        <span
                          class="turnout__mark"
                          style={`background: ${classColor(raider.class) ?? 'var(--border-strong)'}`}
                          aria-hidden="true"
                        />
                        {raider.name}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="muted">Nobody in the log matched the roster.</p>
                )}
              </div>

              <div>
                <h3 class="turnout__head">Said yes, never appeared</h3>
                {report.turnout.missing.length > 0 ? (
                  <>
                    <ul class="turnout__list">
                      {report.turnout.missing.map((raider) => (
                        <li>
                          <span
                            class="turnout__mark"
                            style={`background: ${classColor(raider.class) ?? 'var(--border-strong)'}`}
                            aria-hidden="true"
                          />
                          {raider.name}
                        </li>
                      ))}
                    </ul>
                    <p class="turnout__why">
                      They may have swapped character or arrived after the log started.
                    </p>
                  </>
                ) : (
                  <p class="muted">Everyone who said yes is in the log.</p>
                )}
              </div>

              <div>
                <h3 class="turnout__head">In the log, not on the roster</h3>
                {report.turnout.unknown.length > 0 ? (
                  <>
                    <ul class="turnout__list">
                      {report.turnout.unknown.map((raider) => (
                        <li>
                          <span
                            class="turnout__mark"
                            style={`background: ${classColor(raider.class) ?? 'var(--border-strong)'}`}
                            aria-hidden="true"
                          />
                          {raider.name}
                          <span class="turnout__realm">{raider.realm}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="turnout__why">A pug, a trial, or a character nobody has synced.</p>
                  </>
                ) : (
                  <p class="muted">Everyone in the log is on the roster.</p>
                )}
              </div>
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    /* The event's own edit link and nothing else. A raider never sees this, and a raid
       lead sees one line until they open it: the page is here to read the comp and the
       signups, and an edit is the rarer thing. */
    event && hasLink(event, 'edit') && (
      <details class="edit">
        <summary>Edit event</summary>
        <form method="post" action={`/events/${event.id}/update`} data-astro-reload>
          <div class="edit__grid">
            <div class="field">
              <label for="title">Title</label>
              <input
                id="title"
                name="title"
                type="text"
                value={event.title}
                required
                autocomplete="off"
              />
            </div>

            {/* A dungeon has no raid difficulty, and the service will not take one. */}
            {event.type === 'RAID' && (
              <div class="field">
                <label for="difficulty">Difficulty</label>
                <select id="difficulty" name="difficulty">
                  {/* Offered only while there is none. The service has no way to clear a
                      difficulty once set, so a "Not set" option on an event that has one
                      would be a control that silently does nothing. */}
                  {!event.difficulty && (
                    <option value="" selected>
                      Not set
                    </option>
                  )}
                  {Object.entries(DIFFICULTY_LABELS).map(([value, label]) => (
                    <option value={value} selected={event!.difficulty === value}>
                      {label}
                    </option>
                  ))}
                </select>
              </div>
            )}

            <div class="field">
              <label for="starts_at">Starts</label>
              <input
                id="starts_at"
                name="starts_at"
                type="datetime-local"
                value={instantToGuildTime(event.starts_at, timezone)}
                required
              />
            </div>

            <div class="field">
              <label for="signup_deadline">Signups close</label>
              <input
                id="signup_deadline"
                name="signup_deadline"
                type="datetime-local"
                value={instantToGuildTime(event.signup_deadline, timezone)}
                required
              />
            </div>

            <div class="field">
              <label for="reminder_lead_minutes">Reminder lead</label>
              <input
                id="reminder_lead_minutes"
                name="reminder_lead_minutes"
                type="number"
                min="0"
                max="1440"
                value={event.reminder_lead_minutes ?? ''}
              />
            </div>
          </div>

          <p class="edit__hint">
            Times are read in {timezone ?? 'UTC'}. Leave a comp box empty and Raider Mate works that
            role out when the comp is locked.
          </p>

          <ul class="edit__sizes">
            {SIZES.map((size) => (
              <li class="field">
                <label for={size.name}>{size.label}</label>
                <input
                  id={size.name}
                  name={size.name}
                  type="number"
                  min="0"
                  max="40"
                  value={templateSize(size.name)}
                />
              </li>
            ))}
          </ul>

          <div class="edit__actions">
            <button class="button" type="submit">
              Save event
            </button>
            {/* The one thing an edit cannot change, said once rather than drawn as a
                control that would refuse. */}
            <span class="muted">
              {event.type === 'RAID' ? 'Raid' : 'Mythic+'} for the life of the event.
            </span>
          </div>
        </form>
      </details>
    )
  }

  {
    event && (
      <>
        {/* Not once the log has been read. The raid happened; offering to sign up for it
            is a control that can only be refused. This is the service's answer being
            read back, not a rule invented here: the report link is what says the night
            is over, never a clock. */}
        {unsigned.length > 0 && !flipped && (
          <section class="section signup">
            <h2>Sign up</h2>
            {/* No signup row yet, so there is no allowed_statuses to render from, and
                inventing the rest of the set here would be this repo guessing. Once the
                row exists it carries its own; this is only ever the first CONFIRMED. */}
            <form
              method="post"
              action={`/events/${event.id}/signup`}
              data-astro-reload
              class="signup-form"
            >
              <select name="character_id" required aria-label="Character to sign up">
                <option value="" selected disabled>
                  Choose a character
                </option>
                {unsigned.map((character) => (
                  <option value={character.id}>{character.name}</option>
                ))}
              </select>
              <input type="hidden" name="status" value="CONFIRMED" />
              <button class="button" type="submit">
                Sign up
              </button>
            </form>
          </section>
        )}

        {/* The comp is what a raid lead opens this page for, so it leads. Before it is
             locked there is nothing to show, and a full empty panel would push the
             signups a screen down to say so: one line does the same job.

             Once the log has been read the comp is history: what was planned, beside
             what happened. It keeps every control it had, one disclosure down. */}
        <details class:list={['demoted', !flipped && 'demoted--plain']} open={!flipped}>
          <summary>The comp</summary>
          {boards.length === 0 ? (
            <p class="pending">
              <span class="pending__dot" aria-hidden="true" />
              No comp locked yet. A raid lead locks it from Discord, and it lands here.
            </p>
          ) : (
            <section class="section comps">
              <h2>Comps</h2>
              {boards.map((board) => (
                <div class="panel board">
                  <div class="panel__head">
                    <h3 transition:name={`comp-${event.id}-${board.name}`}>{board.name}</h3>
                    <span class="badge">{board.mode === 'AUTO' ? 'Auto' : 'Manual'}</span>

                    {/* Rendered from the comp's own links. A raider gets none of the
                        transitions; a raid lead gets exactly the ones the service offered
                        on this comp, which is one per mode and never both.

                        The board itself is not a transition, so everyone gets the way in
                        to it. What the link says is the comp's `save` link read back: the
                        same lookup the builder route makes when it decides whether the
                        board moves. */}
                    <div class="board__controls">
                      <a
                        class="button button--quiet"
                        href={`/events/${event.id}/comp/${encodeURIComponent(board.name)}`}
                      >
                        {hasLink(board, 'save') ? 'Edit comp' : 'View comp'}
                      </a>

                      {hasLink(board, 'lock') && (
                        <form
                          method="post"
                          action={`/events/${event.id}/comp-lock`}
                          data-astro-reload
                        >
                          <input type="hidden" name="name" value={board.name} />
                          <button class="button button--ghost" type="submit">
                            Rebuild from signups
                          </button>
                        </form>
                      )}

                      {/* The path docs/design.md describes: lock an auto comp, take it
                          manual, then hand-edit the assigner's output. Converting leaves
                          the slots alone, which is what makes it a starting board rather
                          than an empty one. */}
                      {hasLink(board, 'mode') && board.mode === 'AUTO' && (
                        <form
                          method="post"
                          action={`/events/${event.id}/comp-mode`}
                          data-astro-reload
                        >
                          <input type="hidden" name="name" value={board.name} />
                          <input type="hidden" name="mode" value="MANUAL" />
                          <button class="button" type="submit">
                            Take manual control
                          </button>
                        </form>
                      )}

                      {hasLink(board, 'mode') && board.mode === 'MANUAL' && (
                        <form
                          method="post"
                          action={`/events/${event.id}/comp-mode`}
                          data-astro-reload
                        >
                          <input type="hidden" name="name" value={board.name} />
                          <input type="hidden" name="mode" value="AUTO" />
                          <button class="button button--ghost" type="submit">
                            Hand back to the assigner
                          </button>
                        </form>
                      )}
                    </div>
                  </div>

                  <div class="panel__body">
                    <CompAdvisories advisories={board.advisories} />

                    <div class="roles">
                      {ROLE_ORDER.map((role) => (
                        <div class="role" style={`--hue: ${ROLE_HUES[role]}`}>
                          <h4>
                            <span class="role__dot" aria-hidden="true" />
                            {ROLE_LABELS[role]}
                            <span class="role__count">{inRole(board, role).length}</span>
                          </h4>
                          <ul>
                            {inRole(board, role).map((slot) => (
                              <li>
                                {slotName(slot)}
                                {reasonFor(board, slot) && (
                                  <span class="reason">{reasonFor(board, slot)}</span>
                                )}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>

                    {/* Bench comes from the comp, not from a signup status. A raider can be
                    confirmed and benched at once, and that is the normal case. */}
                    {bench(board).length > 0 && (
                      <div class="bench">
                        <h4>
                          Bench
                          <span class="role__count">{bench(board).length}</span>
                        </h4>
                        <ul>
                          {bench(board).map((slot) => (
                            <li>
                              {slotName(slot)}
                              {reasonFor(board, slot) && (
                                <span class="reason">{reasonFor(board, slot)}</span>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {/* Who the slots leave out. The board is the snapshot the last lock
                        took and signups carry on afterwards, so without this a raider who
                        arrived since is in the table below and on no board, with nothing
                        connecting the two. The list and each reason are the service's
                        answer; only the sentence under the heading is chosen here, and it
                        turns on the mode because a rebuild seats them on one and is
                        refused on the other. */}
                    {board.unseated && board.unseated.length > 0 && (
                      <div class="unseated">
                        <h4>
                          Not on the board
                          <span class="role__count">{board.unseated.length}</span>
                        </h4>
                        <p class="unseated__why">
                          {board.mode === 'AUTO'
                            ? 'The board was built before they signed up. A rebuild seats them.'
                            : 'This board is hand-built, so the assigner leaves it alone.'}
                        </p>
                        <ul>
                          {board.unseated.map((entry) => (
                            <li>
                              {entry.character?.name ?? entry.character_id}
                              <span class="reason">{entry.reason}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </section>
          )}
        </details>

        {/* Not once the log has been read. A late request is a plea to be let onto a raid,
            and approving one after the raid happened changes nothing that can still be
            changed. Same signal as the signup form: the report link is what says the
            night is over, never a clock. */}
        {hasLink(event, 'late-requests') && !flipped && (
          <section class="section">
            <h2>Late requests</h2>
            {lateRequests.length === 0 && (
              <div class="panel">
                <div class="empty">
                  <h3>Nothing waiting</h3>
                  <p>Requests to change a signup after the deadline land here.</p>
                </div>
              </div>
            )}
            {lateRequests.length > 0 && (
              <ul class="requests">
                {lateRequests.map((request) => (
                  <li class="panel">
                    <div class="panel__body">
                      <div class="requests__top">
                        <span class="raider__name">
                          {names.get(request.character_id) ?? request.character_id}
                        </span>
                        <span class="badge">{request.state.toLowerCase()}</span>
                      </div>
                      <p class="muted">
                        Asked for {STATUS_LABELS[request.status]}
                        {request.late_until && (
                          <>
                            {' until '}
                            <time datetime={request.late_until}>
                              {formatEventTime(request.late_until, timezone)}
                            </time>
                          </>
                        )}
                      </p>
                      {request.note && <p class="note">{request.note}</p>}

                      {/* The bot's notice says this is waiting in the dashboard, so the
                          dashboard has to be able to answer it. Both links arrive only on
                          a pending request, and only for a raid lead, so a decided one
                          renders as the badge above and nothing else. */}
                      {(hasLink(request, 'approve') || hasLink(request, 'reject')) && (
                        <div class="requests__controls">
                          {hasLink(request, 'approve') && (
                            <form method="post" action={`/events/${event.id}/late-request`}>
                              <input type="hidden" name="request_id" value={request.id} />
                              <input type="hidden" name="decision" value="approve" />
                              <button class="button" type="submit">
                                Approve
                              </button>
                            </form>
                          )}
                          {hasLink(request, 'reject') && (
                            <form method="post" action={`/events/${event.id}/late-request`}>
                              <input type="hidden" name="request_id" value={request.id} />
                              <input type="hidden" name="decision" value="reject" />
                              <button class="button button--ghost" type="submit">
                                Reject
                              </button>
                            </form>
                          )}
                        </div>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {/* Same demotion as the comp, and for the same reason: after the raid the sheet
             is what people said they would do, not what they did. */}
        <details class:list={['demoted', !flipped && 'demoted--plain']} open={!flipped}>
          <summary>Signups</summary>
          <section class="panel signups">
            <div class="panel__head">
              <h2>Signups</h2>
              {signups.length > 0 && <span class="badge">{signups.length} signed up</span>}
            </div>

            {signups.length === 0 && (
              <div class="empty">
                <h3>Nobody has signed up yet</h3>
                <p>Raiders sign up from the event post in Discord, or from here.</p>
              </div>
            )}

            {shown.length > 0 && (
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Raider</th>
                      <th scope="col" class="num">
                        Item level
                      </th>
                      <th scope="col">Status</th>
                      <th scope="col">Note</th>
                      <th scope="col">
                        <span class="visually-hidden">Actions</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {shown.map((signup) => (
                      <tr class:list={[isMine(signup) && 'row--mine']}>
                        <th scope="row">
                          <span class="raider">
                            <span
                              class="raider__mark"
                              style={`background: ${classColor(signup.character?.class) ?? 'var(--border-strong)'}`}
                              aria-hidden="true"
                            />
                            <span>
                              <span class="raider__name">
                                {signup.character?.name ?? signup.character_id}
                                {isMine(signup) && <span class="yours">You</span>}
                              </span>
                              <span class="raider__sub">
                                {signup.character?.class ?? ''}
                                {signup.character?.spec ? ` ${signup.character.spec}` : ''}
                                {signup.character && signup.character.roles.length > 0 && (
                                  <>
                                    {signup.character.class || signup.character.spec ? ' · ' : ''}
                                    {signup.character.roles
                                      .map((choice) => choice.role)
                                      .join(' / ')}
                                  </>
                                )}
                              </span>
                            </span>
                          </span>
                        </th>
                        {/* Whole numbers: the fraction the sync stores is precision nobody
                          picks a raider on. Absent until the Raider.IO worker has been
                          round, which is a different fact from a low one. */}
                        <td class="num ilvl">
                          {signup.character?.ilvl ? (
                            Math.round(signup.character.ilvl)
                          ) : (
                            <span class="dash">&mdash;</span>
                          )}
                        </td>
                        <td>
                          <span
                            class="badge badge--hue"
                            style={`--hue: ${STATUS_HUES[signup.status]}`}
                          >
                            <span class="badge__dot" />
                            {STATUS_LABELS[signup.status]}
                          </span>
                          {signup.late_until && (
                            <span class="until">
                              until{' '}
                              <time datetime={signup.late_until}>
                                {formatEventTime(signup.late_until, timezone)}
                              </time>
                            </span>
                          )}
                        </td>
                        <td class="note">{signup.note}</td>

                        {/* Rendered from allowed_statuses and the links, and from nothing
                          else. Both absent means this caller cannot act on this signup. */}
                        <td class="controls">
                          <div class="controls__inner">
                            {signup.allowed_statuses && signup.allowed_statuses.length > 0 && (
                              <form
                                method="post"
                                action={`/events/${event.id}/signup`}
                                data-astro-reload
                              >
                                <input
                                  type="hidden"
                                  name="character_id"
                                  value={signup.character_id}
                                />
                                {signup.allowed_statuses.map((status) => (
                                  <button
                                    class="button button--quiet"
                                    type="submit"
                                    name="status"
                                    value={status}
                                    aria-pressed={status === signup.status}
                                    style={`--hue: ${STATUS_HUES[status]}`}
                                  >
                                    {STATUS_LABELS[status]}
                                  </button>
                                ))}
                              </form>
                            )}
                            {hasLink(signup, 'withdraw') && (
                              <form
                                method="post"
                                action={`/events/${event.id}/withdraw`}
                                data-astro-reload
                              >
                                <input
                                  type="hidden"
                                  name="character_id"
                                  value={signup.character_id}
                                />
                                <button class="button button--ghost" type="submit">
                                  Withdraw
                                </button>
                              </form>
                            )}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </details>
      </>
    )
  }
</DashboardLayout>

<style>
  /*
   * The disclosure the comp and the signups move into once the log has been read.
   *
   * Rendered either way rather than conditionally wrapped, because a summary that exists
   * only sometimes would mean two copies of everything inside it. Before the flip it is
   * open with its summary hidden, which is exactly the page that was there before.
   */
  .demoted {
    margin-top: 2.5rem;
  }

  .demoted--plain {
    margin-top: 0;
  }

  .demoted--plain > summary {
    display: none;
  }

  /*
   * A section heading you can fold, not a button.
   *
   * It was a small chip first, which read as a stray control floating under whatever was
   * above it: nothing said it introduced a section, and at that size the marker was a
   * speck. It carries the heading's own type now and rules off the full width, so it
   * reads as the head of the block it opens.
   */
  .demoted > summary {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0 0 0.625rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1rem;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.014em;
    list-style: none;
    transition: color var(--dur-1) var(--ease);
  }

  .demoted > summary::-webkit-details-marker {
    display: none;
  }

  .demoted > summary::after {
    margin-left: auto;
    color: var(--text-tertiary);
    content: 'Show';
    font-size: var(--fs-xs);
    font-weight: 560;
    letter-spacing: 0.01em;
  }

  .demoted[open] > summary::after {
    content: 'Hide';
  }

  /* Rotates rather than swapping glyph, so the marker moves with the disclosure instead
     of blinking into a different character. */
  .demoted > summary::before {
    content: '';
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid currentColor;
    transition: transform var(--dur-1) var(--ease);
  }

  .demoted[open] > summary::before {
    transform: rotate(90deg);
  }

  .demoted > summary:hover {
    color: var(--text-primary);
  }

  /* The board sits under the night with no heading between them, so it needs the space a
     section heading would otherwise have carried. */
  .recap-panel {
    margin-top: 2.5rem;
  }

  .board-head {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  /* What the numbers are of. Under the metric rather than beside it, because the metric
     is what you picked and this is what you picked it on. */
  .board-head__scope {
    margin: 0;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
  }

  .board-reset {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 560;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .board-reset::before {
    content: '\2190';
    margin-right: 0.375rem;
  }

  .board-reset:hover,
  .board-reset:focus-visible {
    color: var(--text-primary);
  }

  /* The three views of one board. Same grammar as the analysis sub-navigation: real
     links, current one marked, no second idea invented for the same job. */
  .metrics {
    display: flex;
    gap: 0.25rem;
  }

  .metrics__link {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 560;
    text-decoration: none;
    transition:
      background var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .metrics__link:hover {
    background: var(--hover);
    color: var(--text-primary);
  }

  .metrics__link[aria-current='page'] {
    background: var(--raised);
    color: var(--text-primary);
  }

  .turnout {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }

  .turnout > * {
    min-width: 0;
  }

  .turnout__head {
    margin: 0 0 0.625rem;
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .turnout__list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .turnout__list li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--fs-sm);
  }

  .turnout__mark {
    width: 3px;
    height: 0.8125rem;
    flex: none;
    border-radius: var(--radius-full);
    transform: translateY(2px);
  }

  .turnout__realm {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
  }

  /* Said once, under the list it belongs to. A no-show list that accuses people is worse
     than no list, and both of these have innocent explanations. */
  .turnout__why {
    max-width: 46ch;
    margin: 0.625rem 0 0;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
  }

  /* Everyone reads a long table looking for their own name first. Pinning the row is
     half of it; the other half is making it findable without reading. */
  .row--mine th,
  .row--mine td {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .row--mine th:first-child {
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .yours {
    margin-left: 0.5rem;
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }

  /* Most of an event's life is spent before the comp is locked, so the not-yet state is
     one line rather than a panel: it says the same thing and costs a signup row instead
     of a screen. */
  .pending {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--raised);
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
  }

  .pending__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--text-tertiary);
  }

  /* A reminder that is on its way is background information: one quiet line, the same
     weight as the times in the header. A reminder that reached nobody wears the notice
     styling instead, because it is something to fix. */
  .reminder {
    margin-bottom: 1rem;
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
  }

  /* Whatever the comp turned out to be, the signups start their own block under it. */
  .signups {
    margin-top: 1.5rem;
  }

  .logs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: var(--fs-sm);
  }

  .logs__link {
    font-weight: 560;
  }

  .logs__edit {
    margin-left: auto;
  }

  .logs__edit summary {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--raised);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .logs__edit summary::-webkit-details-marker {
    display: none;
  }

  .logs__edit summary:hover {
    background: var(--hover);
    border-color: var(--border-strong);
  }

  .logs__forms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .logs__forms form {
    display: flex;
    gap: 0.5rem;
  }

  .logs input[type='url'] {
    min-width: min(24rem, 60vw);
    min-height: 32px;
    padding: 0.4rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--raised);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--fs-sm);
    transition:
      border-color var(--dur-1) var(--ease),
      box-shadow var(--dur-1) var(--ease);
  }

  .logs input[type='url']::placeholder {
    color: var(--text-tertiary);
  }

  .logs input[type='url']:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  /* Closed, this is one line on a page whose job is the comp and the signups. Open, it is
     a form: the same fields the create page asks for, so a raid lead is not learning a
     second shape of the same event. */
  .edit {
    margin-bottom: 1.5rem;
  }

  .edit summary {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.4rem 0.875rem;
