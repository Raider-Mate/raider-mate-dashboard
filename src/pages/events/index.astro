---
import EventChips from '../../components/event-chips.astro';
import BotInstall from '../../components/bot-install.astro';
import DashboardLayout from '../../layouts/dashboard-layout.astro';
import { DIFFICULTY_HUES } from '../../lib/difficulty';
import {
  fetchGuildTimezone,
  formatEventTime,
  formatSignupWindow,
  instantToGuildTime,
} from '../../lib/guild-time';
import { getLink } from '../../lib/links';
import { clampPage, pageWindow } from '../../lib/pagination';
import { noticeFor } from '../../lib/service-notice';
import type { Event } from '../../lib/service-types';

export const prerender = false;

const { session, actor, client } = Astro.locals;

if (!session!.selectedGuildId) {
  return Astro.redirect('/guild');
}

const guildId = session!.selectedGuildId;

const timezone = await fetchGuildTimezone(client, actor, guildId);

// Two lists, one endpoint. The service splits them on starts_at and orders each the way
// it wants to be read: upcoming soonest first, past most recent first.
const past = Astro.url.searchParams.get('scope') === 'past';

let events: Event[] = [];
let failure: string | null = null;

try {
  events = await client.get<Event[]>(
    actor,
    `/api/guilds/${guildId}/events${past ? '?scope=past' : ''}`,
  );
} catch (error) {
  failure = noticeFor(error);
}

// Roughly a screen's worth on the laptop half of a raid lead's desk.
const PER_PAGE = 10;
const pageCount = Math.max(1, Math.ceil(events.length / PER_PAGE));
const page = clampPage(Astro.url.searchParams.get('page'), pageCount);
const start = (page - 1) * PER_PAGE;
const shown = events.slice(start, start + PER_PAGE);

function href(n: number, toPast = past): string {
  const params = new URLSearchParams();
  if (toPast) {
    params.set('scope', 'past');
  }
  if (n > 1) {
    params.set('page', String(n));
  }
  // The calendar's month rides along, so paging the table below does not snap the grid
  // back to today.
  if (month !== todayKey.slice(0, 7)) {
    params.set('month', month);
  }
  const query = params.toString();
  return query ? `/events?${query}` : '/events';
}

const now = new Date();

// --- Calendar ---------------------------------------------------------------------
//
// A second view of the list above, not a second fetch: the service returns every
// future event in one call, so the whole grid is already in `events`.

const MONTH_PARAM = /^\d{4}-(0[1-9]|1[0-2])$/;

// The guild's today, not the container's. A raid at 21:00 in Prague on the 31st is
// still the 31st to the raid lead reading this, and a server thinking in UTC would
// file it under the 1st.
const todayKey =
  instantToGuildTime(now.toISOString(), timezone).slice(0, 10) || now.toISOString().slice(0, 10);

const requestedMonth = Astro.url.searchParams.get('month') ?? '';
const month = MONTH_PARAM.test(requestedMonth) ? requestedMonth : todayKey.slice(0, 7);
const monthYear = Number(month.slice(0, 4));
const monthNumber = Number(month.slice(5, 7));

/** The month `delta` months from the one on screen, named. */
function monthLabel(delta: number): string {
  return new Intl.DateTimeFormat('en-GB', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(monthYear, monthNumber - 1 + delta, 1)));
}

function monthHref(delta: number): string {
  return `/events?month=${new Date(Date.UTC(monthYear, monthNumber - 1 + delta, 1))
    .toISOString()
    .slice(0, 7)}`;
}

/** Just the clock. A cell this narrow has no room for the date and the zone as well. */
function guildClock(iso: string): string {
  return instantToGuildTime(iso, timezone).slice(11, 16);
}

// Monday first. A raid week runs Tuesday to Sunday, and a Sunday-first grid cuts it in
// half across two rows.
const WEEKDAYS: [string, string][] = [
  ['Mon', 'Monday'],
  ['Tue', 'Tuesday'],
  ['Wed', 'Wednesday'],
  ['Thu', 'Thursday'],
  ['Fri', 'Friday'],
  ['Sat', 'Saturday'],
  ['Sun', 'Sunday'],
];

interface CalendarDay {
  key: string;
  date: number;
  inMonth: boolean;
}

const leading = (new Date(Date.UTC(monthYear, monthNumber - 1, 1)).getUTCDay() + 6) % 7;
const monthLength = new Date(Date.UTC(monthYear, monthNumber, 0)).getUTCDate();

const weeks: CalendarDay[][] = [];
for (let cell = 0; cell < Math.ceil((leading + monthLength) / 7) * 7; cell += 7) {
  weeks.push(
    Array.from({ length: 7 }, (_, offset) => {
      const day = new Date(Date.UTC(monthYear, monthNumber - 1, 1 - leading + cell + offset));
      return {
        key: day.toISOString().slice(0, 10),
        date: day.getUTCDate(),
        inMonth: day.getUTCMonth() === monthNumber - 1,
      };
    }),
  );
}

// Left in the order the service sent, so two raids on one night stack in start order
// without this repo deciding that for itself.
const byDay = new Map<string, Event[]>();
for (const event of events) {
  const key = instantToGuildTime(event.starts_at, timezone).slice(0, 10);
  if (!key) {
    continue;
  }
  const onDay = byDay.get(key);
  if (onDay) {
    onDay.push(event);
  } else {
    byDay.set(key, [event]);
  }
}
---

<DashboardLayout title="Events">
  <p slot="head" class="muted">
    {
      past
        ? `Raids ${session!.selectedGuildName} has already run, most recent first.`
        : `Everything still to come in ${session!.selectedGuildName}, soonest first.`
    }
  </p>

  <nav slot="actions" class="scopes" aria-label="Which events">
    <a href={href(1, false)} aria-current={past ? undefined : 'page'}>Upcoming</a>
    <a href={href(1, true)} aria-current={past ? 'page' : undefined}>Past</a>
  </nav>

  {failure && <p class="notice">{failure}</p>}

  {
    !failure && events.length === 0 && (
      <div class="panel">
        <div class="empty">
          <h3>{past ? 'No raids behind you yet' : 'No events on the calendar'}</h3>
          <p>
            {past
              ? 'Once a raid night has started it moves here, and a raid lead can attach its WarcraftLogs report.'
              : `Raid nights are created from Discord. If that is a surprise, ${session!.selectedGuildName} may not be running Raider Mate yet.`}
          </p>
          {!past && <BotInstall />}
        </div>
      </div>
    )
  }

  {
    events.length > 0 && (
      <div class="panel">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Event</th>
                <th scope="col">Type</th>
                <th scope="col">{past ? 'Started' : 'Starts'}</th>
                <th scope="col">{past ? 'Logs' : 'Signups close'}</th>
                <th scope="col">
                  <span class="visually-hidden">Open</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {shown.map((event) => (
                <tr>
                  <th scope="row">
                    {/* The morph starts here. This name is on the event page's title
                        too, so the row travels into the header rather than the list
                        blinking out from under a raid lead mid-scan. */}
                    <a
                      class="row-link"
                      href={`/events/${event.id}`}
                      transition:name={`event-title-${event.id}`}
                    >
                      {event.title}
                    </a>
                  </th>
                  <td>
                    <span transition:name={`event-chips-${event.id}`}>
                      <EventChips event={event} />
                    </span>
                  </td>
                  <td class="when">
                    <time datetime={event.starts_at}>
                      {formatEventTime(event.starts_at, timezone)}
                    </time>
                  </td>
                  {past ? (
                    <td>
                      <span class="cell-label">Logs</span>
                      {/* The link the service offered, not a URL built here. Nothing
                          means nobody has attached a report to this raid. */}
                      {getLink(event, 'warcraftlogs') ? (
                        <span class="logs__yes">Linked</span>
                      ) : (
                        <span class="dash">&mdash;</span>
                      )}
                    </td>
                  ) : (
                    <td>
                      <span class="cell-label">Signups close</span>
                      <span class="closes">{formatSignupWindow(event.signup_deadline, now)}</span>
                      <time class="closes-at" datetime={event.signup_deadline}>
                        {formatEventTime(event.signup_deadline, timezone)}
                      </time>
                    </td>
                  )}
                  <td class="go" aria-hidden="true">
                    <svg viewBox="0 0 16 16" focusable="false">
                      <path
                        d="M6 3.5 10.5 8 6 12.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {pageCount > 1 && (
          <nav class="pagination" aria-label="Events pages">
            <span>
              {start + 1}-{start + shown.length} of {events.length}
            </span>
            <div class="pagination__pages">
              {page > 1 ? (
                <a href={href(page - 1)} rel="prev">
                  Previous
                </a>
              ) : (
                <span aria-disabled="true">Previous</span>
              )}
              {pageWindow(page, pageCount).map((n) =>
                n === null ? (
                  <span class="pagination__gap" aria-hidden="true">
                    &hellip;
                  </span>
                ) : (
                  <a href={href(n)} aria-current={n === page ? 'page' : undefined}>
                    {n}
                  </a>
                ),
              )}
              {page < pageCount ? (
                <a href={href(page + 1)} rel="next">
                  Next
                </a>
              ) : (
                <span aria-disabled="true">Next</span>
              )}
            </div>
          </nav>
        )}
      </div>
    )
  }

  {
    /* Upcoming only. The past list is read newest-first as a log, and a month grid is
      the wrong shape for that. */
  }
  {
    !past && !failure && events.length > 0 && (
      <section class="section">
        <div class="calendar__head">
          <h2>Calendar</h2>
          <nav class="calendar__nav" aria-label="Calendar month">
            <a href={monthHref(-1)} rel="prev" aria-label={`Previous month, ${monthLabel(-1)}`}>
              <span aria-hidden="true">&lsaquo;</span>
            </a>
            <span class="calendar__month">{monthLabel(0)}</span>
            <a href={monthHref(1)} rel="next" aria-label={`Next month, ${monthLabel(1)}`}>
              <span aria-hidden="true">&rsaquo;</span>
            </a>
          </nav>
        </div>

        <div class="panel">
          <table class="calendar">
            <caption class="visually-hidden">Upcoming raids in {monthLabel(0)}</caption>
            <thead>
              <tr>
                {WEEKDAYS.map(([short, full]) => (
                  <th scope="col">
                    <abbr title={full}>{short}</abbr>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {weeks.map((week) => (
                <tr>
                  {week.map((day) => (
                    <td
                      class:list={[
                        'day',
                        !day.inMonth && 'day--adjacent',
                        /* A day already gone holds no upcoming raid by definition. Dimmed
                           so an empty cell reads as "not this list" rather than as "no
                           raid ran". */
                        day.key < todayKey && 'day--gone',
                      ]}
                      aria-current={day.key === todayKey ? 'date' : undefined}
                    >
                      <span class="day__date">{day.date}</span>
                      {(byDay.get(day.key) ?? []).map((event) => {
                        const hue = event.difficulty ? DIFFICULTY_HUES[event.difficulty] : null;
                        return (
                          <a
                            class:list={['pill', hue && 'pill--hue']}
                            style={hue ? `--hue: ${hue}` : undefined}
                            href={`/events/${event.id}`}
                          >
                            <span class="pill__time">{guildClock(event.starts_at)}</span>
                            <span class="pill__title">{event.title}</span>
                            {/* Confirmed only. The service sends every status and
                                deliberately no total, because which of them reads as
                                "coming" depends on what is being drawn: a calendar cell
                                is asking how many are actually turning up. */}
                            {event.signup_counts?.CONFIRMED !== undefined && (
                              <span class="pill__count">{event.signup_counts.CONFIRMED}</span>
                            )}
                          </a>
                        );
                      })}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</DashboardLayout>

<style>
  /* Two views of one collection, so a segmented control rather than a second place in
     the main nav.

     The active pill is a background on the link itself rather than a separate element
     carrying a transition name. A named element is lifted into the view transition
     layer for the swap, where it no longer sits behind anything, so a pill built that
     way paints over its own label and scales between the two sizes on the way across.
     The sliding marker belongs to the main nav, and one of them is enough. */
  .scopes {
    display: flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .scopes a {
    padding: 0.3rem 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease);
  }

  .scopes a:hover {
    color: var(--text-primary);
  }

  .scopes a[aria-current='page'] {
    border-color: var(--border-strong);
    background: var(--raised);
    color: var(--text-primary);
  }

  /* The whole row is the target. The accessible name stays the event title, because
     that is the anchor doing the stretching. */
  tbody tr {
    position: relative;
  }

  .row-link {
    color: var(--text-primary);
    font-size: var(--fs-md);
    font-weight: 560;
    text-decoration: none;
  }

  .row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  tbody tr:hover .row-link,
  .row-link:focus-visible {
    color: var(--accent);
  }

  .when {
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .cell-label {
    display: none;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
  }

  .closes {
    display: block;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .closes-at {
    display: block;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .logs__yes {
    color: var(--success);
  }

  .go {
    width: 1px;
    color: var(--text-tertiary);
    text-align: right;
  }

  .go svg {
    display: block;
    width: 16px;
    height: 16px;
    transition: transform var(--dur-2) var(--ease);
  }

  tbody tr:hover .go {
    color: var(--accent);
  }

  tbody tr:hover .go svg {
    transform: translateX(2px);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------------- calendar */

  .calendar__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  /* .section > h2 already spaces the heading and sets the face; the flex row owns the
     spacing here instead, and the face has to be restated because this h2 is nested. */
  .calendar__head h2 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.004em;
  }

  .calendar__nav {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .calendar__nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: var(--fs-lg);
    line-height: 1;
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .calendar__nav a:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .calendar__month {
    min-width: 9ch;
    color: var(--text-primary);
    font-size: var(--fs-md);
    font-weight: 560;
    text-align: center;
  }

  .calendar {
    table-layout: fixed;
  }

  .calendar thead th {
    padding: 0.5rem 0.5rem;
    text-align: center;
  }

  .calendar thead abbr {
    text-decoration: none;
  }

  /* A calendar cell is a container, not a row of data: the global row hover and the
     generous table padding both read wrong at this size. */
  .calendar tbody tr:hover {
    background: none;
  }

  .calendar tbody td {
    height: 6.5rem;
    padding: 0.375rem;
    border-right: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .calendar tbody td:last-child {
    border-right: 0;
  }

  .day__date {
    display: block;
    margin-bottom: 0.25rem;
    padding-inline: 0.125rem;
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .day--adjacent,
  .day--gone {
    background: color-mix(in srgb, var(--ground) 45%, transparent);
  }

  .day--adjacent .day__date,
  .day--gone .day__date {
    color: var(--text-tertiary);
  }

  /* Today is where a raid lead's eye lands first, so it gets the one warm colour. */
  .calendar td[aria-current='date'] .day__date {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--accent-fg);
    font-weight: 600;
  }

  .pill {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
    padding: 0.1875rem 0.375rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--raised);
    color: var(--text-primary);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition:
      background-color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .pill + .pill {
    margin-top: 0.1875rem;
  }

  .pill:hover {
    background: var(--hover);
    border-color: var(--border-strong);
  }

  .pill--hue {
    border-left-color: var(--hue);
  }

  .pill__time {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .pill__title {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pill__count {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* No table scrolls sideways on a phone. Each row becomes a stacked block with its
     column names inline. */
  @media (max-width: 44rem) {
    thead {
      display: none;
    }

    tbody tr {
      display: grid;
      gap: 0.25rem;
      padding: 0.875rem 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    tbody th,
    tbody td {
      padding: 0;
      border: 0;
    }

    .cell-label {
      display: inline;
      margin-right: 0.375rem;
    }

    .go {
      display: none;
    }

    .when,
    .closes-at {
      font-size: var(--fs-xs);
    }

    .closes {
      display: inline;
    }

    .closes-at {
      display: inline;
      margin-left: 0.375rem;
    }

    /* Everything above restructures the events table into stacked blocks. A calendar is
       seven columns or it is not a calendar, so it opts back out of all of it and drops
       to one dot per raid instead. */
    .calendar thead {
      display: table-header-group;
    }

    .calendar thead th {
      padding: 0.375rem 0.125rem;
    }

    .calendar tbody tr {
      display: table-row;
      gap: 0;
      padding: 0;
      border-bottom: 0;
    }

    .calendar tbody td {
      display: table-cell;
      height: 3.75rem;
      padding: 0.25rem 0.125rem;
      border-right: 1px solid var(--border-subtle);
      text-align: center;
    }

    .calendar tbody td:last-child {
      border-right: 0;
    }

    .day__date,
    .calendar td[aria-current='date'] .day__date {
      margin-inline: auto;
    }

    /* The time and the title stay in the accessible name, so the dot is still a link a
       screen reader can announce in full. */
    .pill {
      display: inline-flex;
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: var(--radius-full);
      background: var(--border-strong);
    }

    .pill--hue {
      background: var(--hue);
    }

    .pill + .pill {
      margin-top: 0;
      margin-left: 3px;
    }

    .pill__time,
    .pill__title,
    .pill__count {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
