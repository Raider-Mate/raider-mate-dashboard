---
import AnalysisNav from '../../components/analysis-nav.astro';
import LockedPanel from '../../components/locked-panel.astro';
import ProportionBar from '../../components/proportion-bar.astro';
import DashboardLayout from '../../layouts/dashboard-layout.astro';
import { fetchAnalysisIndex, followPanel, panelFor, percent } from '../../lib/analysis';
import { ROLE_HUES, ROLE_LABELS, ROLE_ORDER } from '../../lib/roles';
import { noticeFor } from '../../lib/service-notice';
import type { CompBalance } from '../../lib/service-types';

export const prerender = false;

const { session, actor, client } = Astro.locals;

if (!session!.selectedGuildId) {
  return Astro.redirect('/guild');
}

const panel = panelFor('comp');

let balance: CompBalance | null = null;
let failure: string | null = null;

try {
  const index = await fetchAnalysisIndex(client, actor, session!.selectedGuildId);
  balance = await followPanel<CompBalance>(client, actor, index, panel.rel);
} catch (error) {
  failure = noticeFor(error);
}

// The whole list now that the panel has a page of its own. The single-page version cut
// it at eight, which was a space decision, and this page has the space.
const bench = balance?.bench ?? [];
---

<DashboardLayout title={panel.title} titleTransition="analysis-comp">
  <p slot="head" class="muted">{panel.blurb}</p>

  {
    balance && (
      <span slot="actions" class="badge">
        {balance.since.slice(0, 10)} to {balance.until.slice(0, 10)}
      </span>
    )
  }

  <AnalysisNav current="comp" unlocked={balance ? ['comp'] : []} />

  {failure && <p class="notice">{failure}</p>}

  {!balance && !failure && <LockedPanel title={panel.title} blurb={panel.blurb} />}

  {
    balance && (
      <div class="stack">
        <section class="panel">
          <div class="panel__head">
            <h2>What you field</h2>
          </div>
          <div class="panel__body">
            {balance.roles.length > 0 ? (
              <ul class="rows">
                {ROLE_ORDER.filter((role) => balance!.roles.some((row) => row.role === role)).map(
                  (role, index) => {
                    const row = balance!.roles.find((entry) => entry.role === role)!;
                    return (
                      <li class="row">
                        <span class="row__label">{ROLE_LABELS[role]}</span>
                        <ProportionBar
                          index={index}
                          total={row.placed + row.benched}
                          label={`${row.placed} placed, ${row.benched} benched.`}
                          segments={[
                            { hue: ROLE_HUES[role], value: row.placed, label: 'Placed' },
                            { hue: 'var(--text-tertiary)', value: row.benched, label: 'Benched' },
                          ]}
                        />
                        <span class="row__figure">
                          <span class="row__value">{row.placed}</span>
                          <span class="row__note">{percent(row.bench_rate)} benched</span>
                        </span>
                      </li>
                    );
                  },
                )}
              </ul>
            ) : (
              <p class="muted">No comps have been built in the window.</p>
            )}
          </div>
        </section>

        <section class="panel">
          <div class="panel__head">
            <h2>Who carries the bench</h2>
          </div>
          <div class="panel__body">
            {bench.length > 0 ? (
              <ul class="rows">
                {bench.map((record, index) => (
                  <li class="row">
                    <span class="row__label row__label--name">{record.name}</span>
                    {/* Neutral, because the event view draws a bench neutrally too, and
                        because four warning-coloured bars beside the one amber button
                        would take the eye straight off the only thing on the panel you
                        can act on. */}
                    <ProportionBar
                      index={index}
                      total={record.boards}
                      label={`Benched on ${record.benched} of ${record.boards} boards.`}
                      segments={[
                        { hue: 'var(--text-secondary)', value: record.benched, label: 'Benched' },
                      ]}
                    />
                    <span class="row__figure">
                      <span class="row__value">{percent(record.rate)}</span>
                      <span class="row__note">{record.boards} boards</span>
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">Nobody has been benched in the window.</p>
            )}
          </div>
        </section>
      </div>
    )
  }
</DashboardLayout>

<style>
  .stack {
    display: grid;
    /* minmax(0, 1fr) rather than the default auto: a grid item's automatic minimum size
       is its content, so a long name would push the page wider than a phone. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .rows {
    display: grid;
    gap: 0.75rem;
    /* Capped as a block rather than per bar. Left to fill a full-width panel the figure
       column lands against the panel edge and leaves a corridor of nothing between a bar
       and its own number; a bar stretched that far stops being a comparison anyway. */
    max-width: 34rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
  }

  .row__label {
    font-size: var(--fs-sm);
  }

  /* A raider name is longer than a role name and must not be cut to fit a column sized
     for "Ranged". */
  .row__label--name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__figure {
    display: grid;
    justify-items: end;
    line-height: 1.3;
  }

  .row__value {
    font-variant-numeric: tabular-nums;
  }

  .row__note {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  /* On a narrow panel the two-column rows have no room for a label beside a bar, so the
     label takes its own line rather than squeezing the bar out of readability. */
  @media (max-width: 44rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .row__label {
      grid-column: 1 / -1;
    }
  }
</style>
